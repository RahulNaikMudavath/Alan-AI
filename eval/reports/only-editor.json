  "metric_definitions": {
    "precision_at_k": "count(i in 1..min(K,|L|) where L[i] in R) / K. Denominator is K even when fewer than K results were returned. Null when R is empty.",
    "recall_at_k": "count(i in 1..min(K,|L|) where L[i] in R) / |R|. Null when R is empty.",
    "reciprocal_rank": "1 / rank of the first relevant result, or 0 when none is retrieved. Null when R is empty.",
    "mrr": "Mean of reciprocal ranks over scored queries. Null when none are scored.",
    "ndcg_at_k": "Binary-gain DCG@K divided by IDCG@K, where IDCG is summed over min(|R|, K) ideal ranks. Null when R is empty.",
    "hit_at_k": "1 when at least one relevant result appears in L@K, else 0. Null when R is empty.",
    "no_answer_abstained": "1 when no results were returned for a query with an empty relevant set, else 0. Measures restraint, not correctness.",
    "duplicate_handling": "Retrieved IDs are de-duplicated preserving first occurrence before metrics; duplicates are reported and counted separately.",
    "degraded_handling": "Queries whose semantic signal degraded have null metrics and are excluded from mode averages; they are counted separately.",
    "failure_buckets": "Relevance misses, isolation violations, forbidden results, duplicate results, and degraded queries are counted in disjoint buckets. A foreign or forbidden result is reported under integrity, not also as a relevance miss.",
