# Copy this file to `.env` to override defaults locally.
# `.env` is git-ignored. Never commit real API keys.

# Where the SQLite file lives (relative paths resolve from the project root).
RECALLKIT_DATABASE_PATH=data/recallkit.db

# Free-text label shown in logs and in the OpenAPI docs.
RECALLKIT_ENVIRONMENT=development

# --- Embedding provider ---------------------------------------------------
# fake            -> deterministic, offline, free. Default. Measures word
#                    overlap only, NOT meaning. For development and tests.
# openai_compatible -> any /v1/embeddings endpoint (OpenAI, Azure, Ollama,
#                    vLLM, a gateway). Requires RECALLKIT_EMBEDDING_API_KEY.
# none            -> disable embeddings. Semantic search reports degraded.
RECALLKIT_EMBEDDING_PROVIDER=fake

# Optional overrides. Blank means "use the provider default":
#   fake             -> recallkit-fake-hash-v1-256, 256 dimensions
#   openai_compatible -> text-embedding-3-small, 1536 dimensions
RECALLKIT_EMBEDDING_MODEL=
RECALLKIT_EMBEDDING_DIMENSIONS=

# Only used by the openai_compatible provider.
RECALLKIT_EMBEDDING_BASE_URL=https://api.openai.com/v1
RECALLKIT_EMBEDDING_API_KEY=
RECALLKIT_EMBEDDING_TIMEOUT_SECONDS=10

# --- Retrieval tuning -----------------------------------------------------
# Maximum number of vectors compared per semantic query (brute-force scan).
RECALLKIT_SEMANTIC_MAX_CANDIDATES=5000
# Cosine floor for including a semantic hit. 0.0 drops clearly unrelated rows.
RECALLKIT_SEMANTIC_MIN_SIMILARITY=0.0
# How many candidates each signal contributes to hybrid ranking.
RECALLKIT_HYBRID_CANDIDATE_POOL=50
# Reciprocal-rank-fusion weights. Recency only reorders existing matches.
RECALLKIT_HYBRID_KEYWORD_WEIGHT=1.0
RECALLKIT_HYBRID_SEMANTIC_WEIGHT=1.0
RECALLKIT_HYBRID_RECENCY_WEIGHT=0.3
RECALLKIT_RRF_K=60

# --- Fact extraction (POST /conversations) --------------------------------
# fake              -> deterministic rule-based extractor. Offline, free.
#                      A heuristic, NOT a model: it proves the pipeline.
# openai_compatible -> any /v1/chat/completions endpoint. Needs an API key.
# none              -> disable ingestion; the endpoint returns 503.
RECALLKIT_LLM_PROVIDER=fake

# Optional overrides. Blank means "use the provider default":
#   fake              -> recallkit-rule-based-v1
#   openai_compatible -> gpt-4o-mini
RECALLKIT_LLM_MODEL=
RECALLKIT_LLM_BASE_URL=https://api.openai.com/v1
RECALLKIT_LLM_API_KEY=
RECALLKIT_LLM_TIMEOUT_SECONDS=20
RECALLKIT_LLM_JSON_MODE=true

# Request-size limits, enforced before the provider is called.
RECALLKIT_MAX_MESSAGES_PER_CONVERSATION=50
RECALLKIT_MAX_MESSAGE_CHARS=8000
RECALLKIT_MAX_CONVERSATION_CHARS=40000

# Extraction-quality limits.
RECALLKIT_MAX_FACTS_PER_CONVERSATION=10
RECALLKIT_MAX_FACT_CHARS=500
RECALLKIT_MIN_FACT_CONFIDENCE=0.5

# Raw conversations are the most sensitive data RecallKit can hold. When false,
# only extracted facts and message indexes are written to disk.
RECALLKIT_STORE_MESSAGES=false
# --- Conflict candidates (advisory only) ----------------------------------
# Detection never changes a memory's status; it only records a candidate that
# must be resolved explicitly.
RECALLKIT_CONFLICT_DETECTION_ENABLED=true
# Share of the smaller token set that must overlap. A lexical observation,
# not a confidence score.
RECALLKIT_CONFLICT_OVERLAP_THRESHOLD=0.8
RECALLKIT_CONFLICT_CANDIDATE_LIMIT=20
RECALLKIT_CONFLICT_SCAN_LIMIT=500

# --- Local developer dashboard -------------------------------------------
# Served at /dashboard/ by the same FastAPI process. No authentication; keep it
# on localhost. Disable it for shared environments.
RECALLKIT_DASHBOARD_ENABLED=true
# Where the Evaluation Lab reads generated JSON reports.
RECALLKIT_EVAL_REPORTS_PATH=eval/reports
