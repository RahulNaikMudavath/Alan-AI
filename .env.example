# Copy this file to `.env` to override defaults locally.
# `.env` is git-ignored. RecallKit needs no API keys at this milestone, and
# none should ever be committed to this repository.

# Where the SQLite file lives (relative paths resolve from the project root).
RECALLKIT_DATABASE_PATH=data/recallkit.db

# Free-text label shown in logs and in the OpenAPI docs.
RECALLKIT_ENVIRONMENT=development